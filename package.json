{
  "name": "@yamillanz/mcprelay",
  "version": "0.0.3",
  "description": "The reliability layer for MCP tool calls — local-first policy, observability, and a dead-letter queue with replay for any stdio MCP server.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "middleware",
    "proxy",
    "dlq",
    "dead-letter-queue",
    "retry",
    "replay",
    "observability",
    "cli"
  ],
  "license": "MIT",
  "author": "Yamill Anz (https://github.com/yamillanz)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yamillanz/mcprelay.git"
  },
  "bugs": {
    "url": "https://github.com/yamillanz/mcprelay/issues"
  },
  "homepage": "https://github.com/yamillanz/mcprelay#readme",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "bin": {
    "mcprelay": "./dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:examples": "tsc -p tsconfig.examples.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build && npm run build:examples",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "spec:validate": "openspec validate --all",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fission-ai/openspec": "^1.3.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.1.0",
    "@modelcontextprotocol/server": "^2.1.0",
    "better-sqlite3": "^12.11.1",
    "ulid": "^3.0.2",
    "yaml": "^2.9.1"
  }
}
